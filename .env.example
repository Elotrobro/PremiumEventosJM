# Plantilla de variables de entorno para correr el proyecto localmente.
#
# El proyecto NUNCA lee credenciales directamente del código: las lee de
# un archivo ".env" en la raíz (al lado de manage.py) usando la librería
# python-decouple (ver PremiumEventosJM/settings.py). Ese archivo ".env"
# está en .gitignore a propósito, para no subir contraseñas al repositorio.
#
# Cómo usar esta plantilla:
#   1. Copia este archivo y renómbralo a ".env" (sin ".example").
#   2. Reemplaza los valores con los de TU propio MySQL local — cada
#      integrante del equipo pone su propia contraseña, no tienen que
#      coincidir entre sí.
#   3. Asegúrate de tener la base de datos ya creada en tu MySQL:
#        CREATE DATABASE premium_eventos_jm;
#   4. Corre las migraciones: python manage.py migrate
#
# Si falta el archivo ".env" o falta alguna de estas variables, Django
# falla al arrancar con un error como:
#   decouple.UndefinedValueError: 'DB_NAME' not found. ...

DB_NAME=premium_eventos_jm
DB_USER=root
DB_PASSWORD=tu_contraseña_de_mysql
DB_HOST=127.0.0.1
DB_PORT=3306

# ── Correo (recuperación de contraseña) ─────────────────────────────────
# Opcional. Si no se configura, los correos se imprimen en la terminal de
# `runserver` en vez de enviarse (útil para probar). Para enviarlos de
# verdad con Gmail, quita el "#" de estas líneas y usa una "contraseña de
# aplicación" de Google (no la contraseña normal de la cuenta):
#   https://myaccount.google.com/apppasswords
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST_USER=tu_correo@gmail.com
# EMAIL_HOST_PASSWORD=tu_contraseña_de_aplicacion
